{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/state/:key",
      "destination": "/api/state?key=:key"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
